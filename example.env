# Server Configuration
USE_CLOUD=false
PORT=3000

# Get key from: https://aistudio.google.com/

GEMINI_API_KEY=--------------------------------------
FREE_DAILY_GEMINI_LIMIT=25
PAID_DAILY_GEMINI_LIMIT=300
MAX_PENDING_DOCUMENTS_PER_USER=10
MAX_DAILY_UPLOAD_INTENTS_PER_USER=60
REQUIRE_PAID_PLAN_FOR_GEMINI=false
PAID_USER_IDS=
PAID_USER_EMAILS=
BLOCKED_USER_IDS=
BLOCKED_USER_EMAILS=

# Abuse controls
AUTH_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=40
# Questions per user per 15 minutes on POST /api/ask (two Gemini calls each).
ASK_RATE_LIMIT_MAX=30
WORKER_CALLBACK_RATE_LIMIT_MAX=300
DISABLE_RATE_LIMIT=false
CAPTCHA_ENABLED=false
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Model used for extraction and for answering questions over your documents.
GEMINI_MODEL_ID=gemini-2.5-flash

# Embedding model for retrieval. Vectors are stored at 768 dimensions; changing
# either of these requires re-running `npm run rag:reindex -- --all` and, if the
# dimension count changes, a migration to alter the vector column.
EMBEDDING_MODEL_ID=gemini-embedding-001

# If using Docker from docker-compose.yml:

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aicompliance

# Redis Queue

# If using Docker:

REDIS_HOST=redis
REDIS_PORT=6379

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID=price_replace_me
FRONTEND_APP_URL=http://localhost:5173
BILLING_SUCCESS_URL=http://localhost:5173/?billing=success
BILLING_CANCEL_URL=http://localhost:5173/?billing=cancel

AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=AKIA123WMA7MJ123QR6O3NasfdsafCU6O
AWS_SECRET_ACCESS_KEY=ecG0BFGi321C+Za7kwwfasd12312MV+ojOuRlFRi6hr5Xxee/9G9
AWS_BUCKET_NAME=aicompliance-uploads-bucket

# SQS Queue URL will use the same user s3-uploader
SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/46381451234248183327/compliance-job-queue

# Shared secret used by Lambda to call the API worker callback endpoint.
WORKER_CALLBACK_TOKEN=replace_with_a_long_random_secret
WORKER_CALLBACK_API_BASE_URL=http://api.sitesafe.local

# JWT authentication (required in production)
JWT_SECRET=replace_with_a_long_random_jwt_secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
